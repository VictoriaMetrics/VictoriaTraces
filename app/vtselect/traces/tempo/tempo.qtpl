{% import (
	"sort"
	"strconv"

	otelpb "github.com/VictoriaMetrics/VictoriaTraces/lib/protoparser/opentelemetry/pb"
) %}

{% stripspace %}

{% func SearchTagsResponse(resourceTagList, spanTagList, eventTagList, linkTagList, instrumentationScopeTagList []string) %}
{
	{% code
	    sort.Slice(resourceTagList, func(i, j int) bool { return resourceTagList[i] < resourceTagList[j] })
	    sort.Slice(spanTagList, func(i, j int) bool { return spanTagList[i] < spanTagList[j] })
	    sort.Slice(eventTagList, func(i, j int) bool { return eventTagList[i] < eventTagList[j] })
	    sort.Slice(linkTagList, func(i, j int) bool { return linkTagList[i] < linkTagList[j] })
	    sort.Slice(instrumentationScopeTagList, func(i, j int) bool { return instrumentationScopeTagList[i] < instrumentationScopeTagList[j] })
	%}
	"scopes":[
	    {
            "name": "resource",
            "tags": [
                {% if len(resourceTagList) > 0 %}
                    {%q= resourceTagList[0] %}
                    {% for _, tag := range resourceTagList[1:] %}
                        ,{%q= tag %}
                    {% endfor %}
                {% endif %}
            ]
        },
	    {
            "name": "span",
            "tags": [
	            {% if len(spanTagList) > 0 %}
                    {%q= spanTagList[0] %}
                    {% for _, tag := range spanTagList[1:] %}
                        ,{%q= tag %}
                    {% endfor %}
                {% endif %}
            ]
        },
	    {
            "name": "event",
            "tags": [
	            {% if len(eventTagList) > 0 %}
                    {%q= eventTagList[0] %}
                    {% for _, tag := range eventTagList[1:] %}
                        ,{%q= tag %}
                    {% endfor %}
                {% endif %}
            ]
        },
	    {
            "name": "link",
            "tags": [
                {% if len(linkTagList) > 0 %}
                    {%q= linkTagList[0] %}
                    {% for _, tag := range linkTagList[1:] %}
                        ,{%q= tag %}
                    {% endfor %}
                {% endif %}
            ]
        },
	    {
            "name": "instrumentation",
            "tags": [
	            {% if len(instrumentationScopeTagList) > 0 %}
                    {%q= instrumentationScopeTagList[0] %}
                    {% for _, tag := range instrumentationScopeTagList[1:] %}
                        ,{%q= tag %}
                    {% endfor %}
                {% endif %}
            ]
        }
	],
	"metrics": {
	    "inspectedBytes": "0"
	}
}
{% endfunc %}

{% func SearchTagValuesResponse(tagValueList []string) %}
{
	{% code
	    sort.Slice(tagValueList, func(i, j int) bool { return tagValueList[i] < tagValueList[j] })
	%}
	"tagValues":[
        {% if len(tagValueList) > 0 %}
            {
                "type": "string",
                "value": {%q= tagValueList[0] %}
            }
        {% endif %}
        {% if len(tagValueList) > 1 %}
            {% for _, tag := range tagValueList[1:] %}
                ,{
                    "type": "string",
                    "value": {%q= tag %}
                }
            {% endfor %}
        {% endif %}
    ],
	"metrics": {
	    "inspectedBytes": "0"
	}
}
{% endfunc %}

{% func SearchResponse(summaryList []traceSummary) %}
{
	"traces": [
        {% if len(summaryList) > 0 %}
            {%= summaryJson(summaryList[0]) %}
            {% for _, summary := range summaryList[1:] %}
                ,{%= summaryJson(summary) %}
            {% endfor %}
        {% endif %}
    ]
}
{% endfunc %}

{% func summaryJson(summary traceSummary) %}
{
	"traceID":{%q= summary.traceID %},
	"rootServiceName":{%q= summary.rootServiceName %},
	"rootTraceName":{%q= summary.rootTraceName %},
	"startTimeUnixNano":{%dl= summary.startTimeUnixNano %},
	"durationMs":{% if summary.endTimeUnixNano > 0 && summary.startTimeUnixNano > 0 %}{%dl= (summary.endTimeUnixNano - summary.startTimeUnixNano) / 1e6 %}{% else %}0{% endif %},
	"spanSet":{%= spanSetJSON(summary) %},
	"spanSets":[{%= spanSetJSON(summary) %}],
	"serviceStats":{%= serviceStatsJSON(summary.serviceStats) %}
}
{% endfunc %}

{% func spanSetJSON(summary traceSummary) %}
{
	"spans":[
		{% if len(summary.matchedSpans) > 0 %}
			{%= matchedSpanJSON(summary.matchedSpans[0]) %}
			{% for _, sp := range summary.matchedSpans[1:] %}
				,{%= matchedSpanJSON(sp) %}
			{% endfor %}
		{% endif %}
	],
	"matched":{%d= summary.matchedCount %}
}
{% endfunc %}

{% func matchedSpanJSON(sp matchedSpan) %}
{
	"spanID":{%q= sp.spanID %},
	{% if sp.name != "" %}"name":{%q= sp.name %},{% endif %}
	"startTimeUnixNano":{%q= strconv.FormatInt(sp.startTimeUnixNano, 10) %},
	"durationNanos":{%q= strconv.FormatInt(sp.endTimeUnixNano - sp.startTimeUnixNano, 10) %},
	"attributes":[
		{% if len(sp.attributes) > 0 %}
			{%= attrJSON(sp.attributes[0]) %}
			{% for _, a := range sp.attributes[1:] %}
				,{%= attrJSON(a) %}
			{% endfor %}
		{% endif %}
	]
}
{% endfunc %}

{% func attrJSON(a spanAttr) %}
{"key":{%q= a.key %},"value":{"stringValue":{%q= a.value %}}}
{% endfunc %}

{% func serviceStatsJSON(stats map[string]serviceStat) %}
{
	{% code
		names := make([]string, 0, len(stats))
		for name := range stats {
			if name == "" {
				continue
			}
			names = append(names, name)
		}
		sort.Slice(names, func(i, j int) bool { return names[i] < names[j] })
	%}
	{% if len(names) > 0 %}
		{%q= names[0] %}:{%= serviceStatJSON(stats[names[0]]) %}
		{% for _, name := range names[1:] %}
			,{%q= name %}:{%= serviceStatJSON(stats[name]) %}
		{% endfor %}
	{% endif %}
}
{% endfunc %}

{% func serviceStatJSON(stat serviceStat) %}
{"spanCount":{%d= stat.spanCount %}{% if stat.errorCount > 0 %},"errorCount":{%d= stat.errorCount %}{% endif %}}
{% endfunc %}

{% comment %}
TraceByIDV1JSON renders the Tempo /api/traces/<trace_id> (v1) JSON response:
the bare Trace message, whose resource spans are nested under the "batches" key.
{% endcomment %}
{% func TraceByIDV1JSON(resourceSpans []*otelpb.ResourceSpans) %}
{
	"batches":{%= resourceSpansArrayJSON(resourceSpans) %}
}
{% endfunc %}

{% comment %}
TraceByIDV2JSON renders the Tempo /api/v2/traces/<trace_id> JSON response:
the TraceByIDResponse wrapper, with resource spans under trace.resourceSpans.
{% endcomment %}
{% func TraceByIDV2JSON(resourceSpans []*otelpb.ResourceSpans) %}
{
	"trace":{
		"resourceSpans":{%= resourceSpansArrayJSON(resourceSpans) %}
	},
	"metrics":{
		"inspectedBytes":"0"
	}
}
{% endfunc %}

{% func resourceSpansArrayJSON(resourceSpans []*otelpb.ResourceSpans) %}
[
	{% if len(resourceSpans) > 0 %}
		{%= resourceSpansJSON(resourceSpans[0]) %}
		{% for _, rs := range resourceSpans[1:] %}
			,{%= resourceSpansJSON(rs) %}
		{% endfor %}
	{% endif %}
]
{% endfunc %}

{% func resourceSpansJSON(rs *otelpb.ResourceSpans) %}
{
	"resource":{
		"attributes":{%= keyValueListJSON(rs.Resource.Attributes) %}
	},
	"scopeSpans":{%= scopeSpansArrayJSON(rs.ScopeSpans) %}
}
{% endfunc %}

{% func scopeSpansArrayJSON(scopeSpans []*otelpb.ScopeSpans) %}
[
	{% if len(scopeSpans) > 0 %}
		{%= scopeSpansJSON(scopeSpans[0]) %}
		{% for _, ss := range scopeSpans[1:] %}
			,{%= scopeSpansJSON(ss) %}
		{% endfor %}
	{% endif %}
]
{% endfunc %}

{% func scopeSpansJSON(ss *otelpb.ScopeSpans) %}
{
	"scope":{
		"name":{%q= ss.Scope.Name %},
		"version":{%q= ss.Scope.Version %},
		"attributes":{%= keyValueListJSON(ss.Scope.Attributes) %}
	},
	"spans":{%= spansArrayJSON(ss.Spans) %}
}
{% endfunc %}

{% func spansArrayJSON(spans []*otelpb.Span) %}
[
	{% if len(spans) > 0 %}
		{%= spanJSON(spans[0]) %}
		{% for _, s := range spans[1:] %}
			,{%= spanJSON(s) %}
		{% endfor %}
	{% endif %}
]
{% endfunc %}

{% func spanJSON(s *otelpb.Span) %}
{
	"traceId":{%q= hexIDToBase64(s.TraceID) %},
	"spanId":{%q= hexIDToBase64(s.SpanID) %},
	{% if s.ParentSpanID != "" %}
		"parentSpanId":{%q= hexIDToBase64(s.ParentSpanID) %},
	{% endif %}
	"name":{%q= s.Name %},
	"kind":{%q= spanKindName(s.Kind) %},
	"startTimeUnixNano":{%q= strconv.FormatUint(s.StartTimeUnixNano, 10) %},
	"endTimeUnixNano":{%q= strconv.FormatUint(s.EndTimeUnixNano, 10) %},
	"attributes":{%= keyValueListJSON(s.Attributes) %},
	"status":{%= statusJSON(s.Status) %}
	{% if len(s.Events) > 0 %}
		,"events":{%= eventsArrayJSON(s.Events) %}
	{% endif %}
	{% if len(s.Links) > 0 %}
		,"links":{%= linksArrayJSON(s.Links) %}
	{% endif %}
}
{% endfunc %}

{% func statusJSON(st otelpb.Status) %}
{
	{% if st.Message != "" %}
		"message":{%q= st.Message %}{% if st.Code != 0 %},{% endif %}
	{% endif %}
	{% if st.Code != 0 %}
		"code":{%q= statusCodeName(st.Code) %}
	{% endif %}
}
{% endfunc %}

{% func eventsArrayJSON(events []*otelpb.SpanEvent) %}
[
	{% if len(events) > 0 %}
		{%= eventJSON(events[0]) %}
		{% for _, e := range events[1:] %}
			,{%= eventJSON(e) %}
		{% endfor %}
	{% endif %}
]
{% endfunc %}

{% func eventJSON(e *otelpb.SpanEvent) %}
{
	"timeUnixNano":{%q= strconv.FormatUint(e.TimeUnixNano, 10) %},
	"name":{%q= e.Name %},
	"attributes":{%= keyValueListJSON(e.Attributes) %}
}
{% endfunc %}

{% func linksArrayJSON(links []*otelpb.SpanLink) %}
[
	{% if len(links) > 0 %}
		{%= linkJSON(links[0]) %}
		{% for _, l := range links[1:] %}
			,{%= linkJSON(l) %}
		{% endfor %}
	{% endif %}
]
{% endfunc %}

{% func linkJSON(l *otelpb.SpanLink) %}
{
	"traceId":{%q= hexIDToBase64(l.TraceID) %},
	"spanId":{%q= hexIDToBase64(l.SpanID) %},
	"attributes":{%= keyValueListJSON(l.Attributes) %}
}
{% endfunc %}

{% func keyValueListJSON(kvs []*otelpb.KeyValue) %}
[
	{% if len(kvs) > 0 %}
		{%= keyValueJSON(kvs[0]) %}
		{% for _, kv := range kvs[1:] %}
			,{%= keyValueJSON(kv) %}
		{% endfor %}
	{% endif %}
]
{% endfunc %}

{% func keyValueJSON(kv *otelpb.KeyValue) %}
{
	"key":{%q= kv.Key %},
	"value":{%= anyValueJSON(kv.Value) %}
}
{% endfunc %}

{% func anyValueJSON(v *otelpb.AnyValue) %}
{
	{% if v == nil %}
	{% elseif v.StringValue != nil %}
		"stringValue":{%q= *v.StringValue %}
	{% elseif v.BoolValue != nil %}
		"boolValue":{% if *v.BoolValue %}true{% else %}false{% endif %}
	{% elseif v.IntValue != nil %}
		"intValue":{%q= strconv.FormatInt(*v.IntValue, 10) %}
	{% elseif v.DoubleValue != nil %}
		"doubleValue":{%f= *v.DoubleValue %}
	{% elseif v.BytesValue != nil %}
		"bytesValue":{%q= bytesToBase64(*v.BytesValue) %}
	{% elseif v.ArrayValue != nil %}
		"arrayValue":{"values":{%= anyValueArrayJSON(v.ArrayValue.Values) %}}
	{% elseif v.KeyValueList != nil %}
		"kvlistValue":{"values":{%= keyValueListJSON(v.KeyValueList.Values) %}}
	{% endif %}
}
{% endfunc %}

{% func anyValueArrayJSON(values []*otelpb.AnyValue) %}
[
	{% if len(values) > 0 %}
		{%= anyValueJSON(values[0]) %}
		{% for _, v := range values[1:] %}
			,{%= anyValueJSON(v) %}
		{% endfor %}
	{% endif %}
]
{% endfunc %}

{% endstripspace %}
