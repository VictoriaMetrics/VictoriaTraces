{
  "name": "vmui",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:playground": "cross-env PLAYGROUND=TRACES npm run start",
    "build": "vite build",
    "lint": "eslint --format stylish 'src/**/*.{ts,tsx}'",
    "lint:local": "eslint --ext .ts,.tsx -f stylish src",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "gen:logsql-pipes": "tsx --tsconfig scripts/tsconfig.json scripts/extractPipes.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "precommit": "npm run lint:local && npm run typecheck && npm run test"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "deep-freeze": "0.0.1",
    "lodash": "4.18.1",
    "lodash.debounce": "^4.0.8",
    "preact": "^10.29.7",
    "qs": "^6.15.3",
    "query-string": "^9.3.1",
    "react-input-mask": "^2.0.4",
    "react-router-dom": "^7.18.1",
    "uplot": "^1.6.32",
    "vite": "^8.2.2",
    "web-vitals": "^6.2.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/deep-freeze": "0.1.5",
    "@types/lodash": "4.17.25",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.17",
    "@types/react-input-mask": "^3.0.6",
    "@types/react-router-dom": "^5.3.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
